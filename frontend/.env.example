# ─── DealTrip ────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. DealTrip runs without any of these set:
# the LLM layer falls back to a deterministic planner and payments run in
# simulation — but the real demo needs Razorpay test keys and a Groq key.

# Razorpay — TEST MODE ONLY. dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Groq. console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Postgres (Neon, Supabase, or local). Omit to run on an in-memory store.
DATABASE_URL=

NEXT_PUBLIC_APP_URL=http://localhost:3000
