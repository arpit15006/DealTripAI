# ─── DealTrip ────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. DealTrip runs without any of these set:
# the LLM layer falls back to a deterministic planner and payments run in
# simulation — but the real demo needs Razorpay test keys and a Groq key.

# Razorpay — TEST MODE ONLY. dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Webhook secret — Dashboard → Settings → Webhooks. Confirms bookings
# even if the traveller's browser never calls back.
RAZORPAY_WEBHOOK_SECRET=

# Groq. console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Postgres (Neon, Supabase, or local). Omit to run on an in-memory store.
#
# REQUIRED on Vercel or any serverless host. Each invocation is a separate
# instance, so the in-memory fallback cannot carry a negotiation from one
# request to the next. It exists for local runs and as a degraded mode when a
# database is briefly unreachable, not as a deployment option.
DATABASE_URL=

# Only needed if the deployment sits behind a proxy that rewrites the Host
# header. Agent-facing URLs are otherwise derived from the incoming request, so
# preview deployments advertise their own domain without configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
